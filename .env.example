# ===========================================
# AI Log Analyzer SaaS - Environment Variables
# ===========================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Authentication uses a custom RS256 JWT system (see src/lib/auth/jwt.ts +
# src/lib/auth/session.ts). No NextAuth variables are needed.

# JWT Keys (PKCS#8 private + SPKI public — the format src/lib/auth/jwt.ts imports).
# Regenerate with these exact commands:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private_pkcs8.pem
#   openssl rsa -pubout -in jwt_private_pkcs8.pem -out jwt_public.pem
# Then paste the file contents (escaping newlines as \n) below, with the BEGIN/END
# headers preserved exactly. Keep the trailing \n after the END line — jwt.ts
# substitutes them via .replace(/\\n/g, '\n').
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR-PKCS8-PRIVATE-KEY-HERE\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR-SPKI-PUBLIC-KEY-HERE\n-----END PUBLIC KEY-----\n"

# AI provider — Anthropic Claude is PAID, OpenRouter has a real free tier.
# Pick one of these two configurations:

# ─── Option A: Free tier via OpenRouter (recommended default) ────────────────
# Get a free key at https://openrouter.ai/keys. Free models are rate-limited
# (~50 req/day per model on the free tier) but work for development and demo.
# Browse models at https://openrouter.ai/models?q=free
AI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_API_KEY="sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
OPENAI_COMPATIBLE_BASE_URL="https://openrouter.ai/api/v1"
# Strong free choices:
#   meta-llama/llama-3.3-70b-instruct:free        (best balance, 70B params)
#   deepseek/deepseek-r1:free                     (reasoning-heavy)
#   qwen/qwen-2.5-72b-instruct:free               (multilingual)
#   mistralai/mistral-nemo:free                   (fast, small)
OPENAI_COMPATIBLE_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# ─── Option B: Anthropic Claude (paid, best quality) ─────────────────────────
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY="sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ─── Option C: Point at any OpenAI-compatible endpoint (Groq, Ollama, etc.) ──
# AI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL="https://api.groq.com/openai/v1"
# OPENAI_COMPATIBLE_API_KEY="gsk_..."
# OPENAI_COMPATIBLE_MODEL="llama-3.3-70b-versatile"
# ...or local:
# OPENAI_COMPATIBLE_BASE_URL="http://localhost:11434/v1"
# OPENAI_COMPATIBLE_API_KEY="ollama"            (any non-empty string)
# OPENAI_COMPATIBLE_MODEL="qwen2.5:7b-instruct"

# Hard cap on tokens sent to the AI per request. Default 6000 matches the tightest
# common free tier (Groq on_demand ≈ 12k TPM — headroom left for response + a retry).
# Lower it if you still hit HTTP 413, raise to ~16000 on a paid Groq/OpenRouter tier.
# AI_MAX_INPUT_TOKENS=6000

# Redis (Upstash) — distributed rate limiting via src/lib/security/rateLimiter.ts
# Uses the REST API (no TCP). Create a free DB at https://upstash.com. While these
# are placeholders, rate limiting is disabled (fail-open) to keep local dev simple.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Monitoring
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
